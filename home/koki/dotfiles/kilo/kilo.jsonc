{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "bash": {
      "find *": "allow",
      "head *": "allow",
      "git -C *": "allow",
      "read *": "allow",
      "cat *": "allow",
      "echo *": "allow",
      "grep *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "hyprpaper *": "allow",
      "hyprctl *": "allow",
      "pkill *": "allow",
      "sleep *": "allow",
      "nix *": "allow",
      "linux-wallpaperengine *": "allow",
      "nix-shell *": "allow",
      "XDG_SESSION_TYPE=wayland *": "allow",
      "/tmp/test-fhs-link *": "allow",
      "/tmp/test-fhs-link/bin/test-fhs *": "allow",
      "nix-env *": "allow",
      "rm *": "allow",
      "tail *": "allow",
      "/nix/store/x4m5ja2330if46sw08lgwwa57bqw9adm-bubblewrap-0.11.2/bin/bwrap *": "allow",
      "readlink *": "allow",
      "ls *": "allow",
      "ldd *": "allow",
      "readelf *": "allow",
      "xxd *": "allow",
      "/nix/store/x4m5ja2330if46sw08lgwwa57bqw9adb-bubblewrap-0.11.2/bin/bwrap *": "allow",
      "$BWRAP *": "allow",
      "git add *": "allow",
      "pgrep *": "allow",
      "ps *": "allow",
      "steam-run *": "allow",
      "git ls-files *": "allow",
      "git status *": "allow",
      "sudo *": "allow",
      "nix-store *": "allow",
      "nix-instantiate *": "allow",
      "dirname *": "allow",
      "xargs *": "allow",
      "\"$CLICKGEN/bin/ctgen\" *": "allow",
      "mktemp *": "allow",
      "git clone *": "allow",
      "\"$HX/bin/hyprcursor-util\" *": "allow",
      "strings *": "allow",
      "od *": "allow",
      "sort *": "allow",
      "sed *": "allow",
      "hyprcursor-util *": "allow",
      "mkdir *": "allow",
      "python3 *": "allow",
      "unzip *": "allow",
      "curl *": "allow",
      "nix-build *": "allow",
      "tr *": "allow",
      "nl *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "python *": "allow",
      "perl *": "allow"
    },
    "external_directory": {
      "/home/koki/.config/*": "allow",
      "/home/koki/nixos-config/*": "allow",
      "/tmp/*": "allow",
      "/proc/sys/kernel/*": "allow",
      "/proc/sys/user/*": "allow",
      "/home/koki/.local/share/osuconfig/*": "allow",
      "/home/koki/.local/share/yawl/*": "allow",
      "/home/koki/.local/bin/*": "allow",
      "/home/koki/.local/share/osu-wine/*": "allow",
      "/home/koki/.local/share/applications/*": "allow",
      "/nix/store/4qvirn9h696v8jbz2qnx1ragmscwpn07-catppuccin-kvantum-0-unstable-2025-12-27/share/Kvantum/catppuccin-frappe-blue/*": "allow",
      "/nix/store/6vg3mj2vsih5ax1fdv5ri0fzw1gzb57l-adwaita-qt-1.4.2/share/doc/adwaita-qt/*": "allow",
      "/nix/store/ka567n7lb6wpfrl8yb05f01l09rc6k46-vkc268ndpcmqzqa1lxijdd5x16mqwani-source/pkgs/by-name/bi/bibata-cursors/*": "allow",
      "/nix/store/ka567n7lb6wpfrl8yb05f01l09rc6k46-vkc268ndpcmqzqa1lxijdd5x16mqwani-source/pkgs/development/python-modules/clickgen/*": "allow",
      "/nix/store/ka567n7lb6wpfrl8yb05f01l09rc6k46-vkc268ndpcmqzqa1lxijdd5x16mqwani-source/pkgs/by-name/no/nordzy-cursor-theme/*": "allow",
      "/nix/store/78alwxxdax9a1516a7rfr84i92ik43cl-home-manager-source/modules/config/*": "allow"
    },
    "*": {
      "*": "allow"
    }
  }
}